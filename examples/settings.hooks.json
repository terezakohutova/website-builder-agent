{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/skills/website-build/scripts/backup/snapshot.py\" hook",
            "statusMessage": "Saving a version of the file..."
          }
        ]
      }
    ]
  }
}
